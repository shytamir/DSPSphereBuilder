<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>DSPSphereBuilder.Feasibility</AssemblyName>
    <RootNamespace>DSPSphereBuilder.Feasibility</RootNamespace>
    <Version>0.0.0</Version>
    <InformationalVersion>$(ProbeRevision)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <LangVersion>latest</LangVersion>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp" HintPath="$(DspManagedPath)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="BepInEx" HintPath="$(BepInExCorePath)/BepInEx.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(DspManagedPath)/UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(DspManagedPath)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(DspManagedPath)/UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(DspManagedPath)/UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(DspManagedPath)/UnityEngine.TextRenderingModule.dll" Private="false" />
    <EmbeddedResource Include="$(ProbePlanPath)" LogicalName="plan.json" />
  </ItemGroup>
  <Target Name="CheckProbeInputs" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(ProbeRevision)' == '' Or !Exists('$(ProbePlanPath)')" Text="ProbeRevision and ProbePlanPath are required." />
  </Target>
</Project>
